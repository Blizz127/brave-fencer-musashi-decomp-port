# Disassembly and decompiled sources generated from, or derived from, retail
# code and the upstream decompilation. Not part of this repository.
/asm/
/vendor/
/include/*.inc
/include/m2c_macros.h

# Fetched toolchains and third-party trees (tools/fetch_toolchains.sh,
# tools/fetch_lua.sh, mkpsxiso). Never redistributed from here.
/tools/third_party/
/tools/psyq/
/tools/maspsx/
/tools/m2c/

# splat regenerates these from the user's executable on every split.
config/*.ld
config/*.auto.txt

# Local match registry and its lock (large; see EXCLUDED.md).
